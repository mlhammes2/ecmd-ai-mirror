// --- backend/googleMaps.jsw ---

import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';

export async function getDrivingETA(origin, destination) {
    try {
        console.log(`📌 [BACKEND_GOOGLE_MAPS -> getDrivingETA]: Computing route from "${origin}" to "${destination}"`);
        const apiKey = await getSecret("GOOGLE_MAPS_KEY");
        const url = `https://routes.googleapis.com/directions/v2:computeRoutes`;

        let originData;
        if (/^-?\d+(\.\d+)?,-?\d+(\.\d+)?$/.test(origin)) {
            let parts = origin.split(',');
            originData = {
                location: {
                    latLng: {
                        latitude: parseFloat(parts[0]),
                        longitude: parseFloat(parts[1])
                    }
                }
            };
        } else {
            originData = { address: origin };
        }

        const requestBody = {
            origin: originData,
            destination: { address: destination },
            travelMode: "DRIVE"
        };

        const response = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Goog-Api-Key': apiKey,
                'X-Goog-FieldMask': 'routes.duration,routes.distanceMeters'
            },
            body: JSON.stringify(requestBody)
        });

        const data = await response.json();

        if (data.routes && data.routes.length > 0) {
            const route = data.routes[0];
            
            const distMeters = route.distanceMeters || 0;
            const distanceMiles = (distMeters * 0.000621371).toFixed(1) + " mi";
            
            const durString = route.duration || "0s";
            const durationSeconds = parseInt(durString.replace('s', ''));
            const durationMinutes = Math.round(durationSeconds / 60) + " mins";

            console.log(`📌 [BACKEND_GOOGLE_MAPS -> getDrivingETA]: Route found: ${distanceMiles} (${durationMinutes})`);
            return { success: true, distance: distanceMiles, duration: durationMinutes };
        } else {
            throw new Error(data.error?.message || "No valid route found by Google.");
        }
    } catch (error) {
        console.error("📌 [BACKEND_GOOGLE_MAPS -> getDrivingETA]: 🚨 Routes API Calculation Failed:", error);
        return { success: false, error: error.message };
    }
}