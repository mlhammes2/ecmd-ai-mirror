// --- backend/googleReviews.jsw ---

import { fetch } from 'wix-fetch';
import wixSecretsBackend from 'wix-secrets-backend';

const PLACE_ID = "ChIJtVtDHKzekIgRD-KdxocP0HI";

// 🌟 IN-MEMORY CACHE
let cachedData = null;
let lastFetchTime = 0;
const CACHE_DURATION_MS = 12 * 60 * 60 * 1000; // 12 Hours

export async function getReviewStats() {
    const now = Date.now();

    // 1. CACHE CHECK
    if (cachedData && (now - lastFetchTime < CACHE_DURATION_MS)) {
        console.log("📌 [BACKEND_GOOGLE_REVIEWS -> getReviewStats]: ⚡ Serving Google Reviews from 12hr Cache!");
        return cachedData;
    }

    try {
        const API_KEY = await wixSecretsBackend.getSecret("GooglePlacesAPIKey");
        const url = `https://maps.googleapis.com/maps/api/place/details/json?place_id=${PLACE_ID}&fields=rating,user_ratings_total&key=${API_KEY}`;
        
        console.log("📌 [BACKEND_GOOGLE_REVIEWS -> getReviewStats]: 🌐 Fetching fresh reviews from Google API...");
        
        const fetchPromise = fetch(url, { method: 'get' });
        const timeoutPromise = new Promise((_, reject) => 
            setTimeout(() => reject(new Error("Timeout Exceeded")), 5000)
        );
        
        const response = await Promise.race([fetchPromise, timeoutPromise]);
        
        if (!response.ok) {
            throw new Error(`Google API responded with status: ${response.status}`);
        }
        
        const data = await response.json();
        
        cachedData = data;
        lastFetchTime = now;
        
        return data; 
        
    } catch (err) {
        console.error("📌 [BACKEND_GOOGLE_REVIEWS -> getReviewStats]: 🚨 Google Review Fetch Error:", err.message);
        
        if (cachedData) {
            console.warn("📌 [BACKEND_GOOGLE_REVIEWS -> getReviewStats]: Falling back to expired cache.");
            return cachedData;
        }
        
        return { status: "FETCH_ERROR", error_message: err.message };
    }
}