//----backend/job.config



{
  "jobs": [
    {
      "functionLocation": "/calendarTasks.js",
      "functionName": "releaseAbandonedTimeSlots",
      "description": "Wipes held calendar slots from temporaryData if inactive for 15+ minutes",
      "executionConfig": {
        "cronExpression": "*/15 * * * *"
      }
    },
    {
      "functionLocation": "/detailerScheduleClean.jsw",
      "functionName": "deleteExpiredRules",
      "description": "Deletes expired availability rules every night",
      "executionConfig": {
        "time": "02:00"
      }
    }
  ]
}