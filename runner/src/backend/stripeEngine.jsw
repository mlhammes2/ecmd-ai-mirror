// --- backend/stripeEngine.jsw ---

import { getSecret } from 'wix-secrets-backend';
import { fetch } from 'wix-fetch';

/**
 * SCENARIO 1: Create Payment Intent for NEW Cards or Wallets
 */
export async function createPaymentIntent(amount, methodName) {
    try {
        const secretKey = await getSecret("STRIPE_SECRET_KEY");
        const publishableKey = await getSecret("STRIPE_PUBLISHABLE_KEY");
        
        const amountInCents = Math.round(amount * 100);
        const selectedStripeMethod = methodName || "card";

        console.log(`📌 [BACKEND_STRIPE -> createPaymentIntent]: Creating PaymentIntent for $${amount} (${amountInCents} cents) via method='${selectedStripeMethod}'`);

        const bodyData = `amount=${amountInCents}&currency=usd&automatic_payment_methods[enabled]=false&payment_method_types[]=${selectedStripeMethod}`;

        const response = await fetch('https://api.stripe.com/v1/payment_intents', {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${secretKey}`,
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: bodyData
        });

        if (!response.ok) {
            throw new Error(`Stripe API error: ${response.statusText}`);
        }

        const paymentIntent = await response.json();
        console.log(`📌 [BACKEND_STRIPE -> createPaymentIntent]: Created PaymentIntent id=${paymentIntent.id}`);

        return {
            clientSecret: paymentIntent.client_secret,
            publishableKey: publishableKey
        };
    } catch (error) {
        console.error("📌 [BACKEND_STRIPE -> createPaymentIntent]: 🚨 Failed to create PaymentIntent:", error);
        throw error;
    }
}

/**
 * SCENARIO 2: Charge a Saved Card Instantly
 */
export async function chargeSavedCard(amount, customerId, paymentMethodId) {
    try {
        const secretKey = await getSecret("STRIPE_SECRET_KEY");
        const amountInCents = Math.round(amount * 100);

        console.log(`📌 [BACKEND_STRIPE -> chargeSavedCard]: Charging $${amount} (${amountInCents} cents) on saved card=${paymentMethodId}`);

        const bodyData = `amount=${amountInCents}&currency=usd&customer=${customerId}&payment_method=${paymentMethodId}&confirm=true&return_url=https://www.ecmdutah.com`;

        const response = await fetch('https://api.stripe.com/v1/payment_intents', {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${secretKey}`,
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: bodyData
        });

        const paymentIntent = await response.json();

        if (!response.ok) {
            throw new Error(paymentIntent.error?.message || "Stripe API error");
        }

        console.log(`📌 [BACKEND_STRIPE -> chargeSavedCard]: Charge result status='${paymentIntent.status}' (id=${paymentIntent.id})`);

        return {
            status: paymentIntent.status, // "succeeded" or "requires_action"
            clientSecret: paymentIntent.client_secret 
        };
    } catch (error) {
        console.error("📌 [BACKEND_STRIPE -> chargeSavedCard]: 🚨 Failed to charge saved card:", error);
        throw error;
    }
}